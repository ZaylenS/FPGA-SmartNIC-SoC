/log.txt
/programs/arm/sort_exp_dump.txt

# Keep only the synthesis inputs required to reproduce the build
/synth/*
!/synth/Makefile
!/synth/nf2_top.scr
!/synth/nf2_top.prj
!/synth/nf2_top.ucf