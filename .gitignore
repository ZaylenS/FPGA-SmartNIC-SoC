# Private project notes and datasets
/docs/
/datasets/
/.claude/
/.agents/
/.codex/
/AGENTS.md
/CLAUDE.md

# Python-generated files and local experiment results
__pycache__/
*.py[cod]
/scripts/*.csv
/scripts/*.log
/scripts/pareto*.txt

